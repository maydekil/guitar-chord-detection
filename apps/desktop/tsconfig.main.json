{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "rootDir": "src/main",
        "outDir": "dist/main",
        "types": [
            "node",
            "electron"
        ]
    },
    "include": [
        "src/main/**/*.ts"
    ],
    "exclude": [
        "src/main/**/*.test.ts"
    ]
}