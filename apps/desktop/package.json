{
    "name": "@gcd/desktop",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/main/main.js",
    "scripts": {
        "clean": "rimraf dist",
        "dev": "concurrently -k -n RENDERER,MAIN,PRELOAD,ELECTRON \"pnpm run dev:renderer\" \"pnpm run dev:main\" \"pnpm run dev:preload\" \"pnpm run dev:electron\"",
        "dev:renderer": "vite",
        "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
        "dev:preload": "tsc -p tsconfig.preload.json --watch --preserveWatchOutput",
        "dev:electron": "wait-on dist/main/main.js dist/preload/index.js tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
        "build": "pnpm run clean && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@gcd/shared": "workspace:*",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^24.5.2",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.2",
        "concurrently": "^9.2.1",
        "cross-env": "^10.0.0",
        "electron": "^38.1.0",
        "jsdom": "^26.1.0",
        "rimraf": "^6.0.1",
        "vite": "^7.1.5",
        "vitest": "^3.2.4",
        "wait-on": "^9.0.1"
    }
}